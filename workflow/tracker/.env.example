HOST=127.0.0.1
PORT=4310
TICKETS_ROOT=/absolute/path/to/tickets
# Optional Jira Cloud integration (only read when jira.enabled is true)
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional GitHub PR observation
GITHUB_TOKEN=
HEARTBEAT_INTERVAL_MS=30000
LEASE_TTL_MS=120000
CLAIM_WAIT_MS=30000
SUPERVISOR_TTL_MS=90000
# Jira and GitHub requests fail with UPSTREAM_TIMEOUT after this deadline.
EXTERNAL_REQUEST_TIMEOUT_MS=15000
# Structured logs use debug, info, warn, or error. LOG_FILE enables built-in
# size rotation; deploy.sh sets it from DEPLOY_LOG_FILE automatically.
LOG_LEVEL=info
# LOG_FILE=/absolute/path/to/agentic-project-tracker.log
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=5
