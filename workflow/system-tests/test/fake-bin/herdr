#!/usr/bin/env node

import { appendFileSync, existsSync, readFileSync, writeFileSync } from "node:fs";
import { spawnSync } from "node:child_process";
import { dirname } from "node:path";

const rawArguments = process.argv.slice(2);
const sessionOffset = rawArguments[0] === "--session" ? 2 : 0;
const args = rawArguments.slice(sessionOffset);
const logPath = process.env.FAKE_HERDR_LOG;
const statePath = process.env.FAKE_HERDR_STATE;

const credentialNames = new Set([
  "ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN", "OPENAI_API_KEY", "CODEX_API_KEY", "PI_API_KEY",
  "GITHUB_TOKEN", "GH_TOKEN", "JIRA_API_TOKEN", "AWS_SECRET_ACCESS_KEY", "AWS_SESSION_TOKEN",
  "AZURE_CLIENT_SECRET", "GOOGLE_APPLICATION_CREDENTIALS",
]);
const leakedCredentials = Object.keys(process.env).filter((name) => credentialNames.has(name)
  || /^(ANTHROPIC|CLAUDE|OPENAI|CODEX)_.+(TOKEN|KEY|SECRET|CREDENTIALS)$/i.test(name));
if (leakedCredentials.length) {
  console.error(`fake herdr received provider credentials: ${leakedCredentials.join(", ")}`);
  process.exit(69);
}

if (!logPath || !statePath) {
  console.error("fake herdr requires FAKE_HERDR_LOG and FAKE_HERDR_STATE");
  process.exit(64);
}

appendFileSync(logPath, `${JSON.stringify({ at: new Date().toISOString(), args })}\n`);

function readState() {
  return existsSync(statePath)
    ? JSON.parse(readFileSync(statePath, "utf8"))
    : { pane: "fake-pane-1", session: "fake-session-1", callback_submitted: false, prompt_attempts: 0 };
}

function writeState(state) {
  writeFileSync(statePath, `${JSON.stringify(state, null, 2)}\n`);
}

function respond(result) {
  process.stdout.write(`${JSON.stringify({ result })}\n`);
}

async function completePrompt(prompt, state) {
  const startHere = prompt.match(/(\/[^`\n]+\/START_HERE\.md)/)?.[1];
  if (!startHere) {
    console.error("fake herdr could not locate START_HERE.md in the assignment prompt");
    process.exit(65);
  }
  if (!state.callback_submitted) {
    const runDirectory = dirname(startHere);
    const configuration = JSON.parse(readFileSync(`${runDirectory}/callbacks.json`, "utf8"));
    const outcome = configuration.allowed_outcomes[0]?.id;
    if (!outcome) {
      console.error("fake herdr found no allowed completion outcome");
      process.exit(66);
    }
    if (process.env.FAKE_HERDR_PUBLISH_EVIDENCE === "true" && !state.evidence_published) {
      const reportPath = `${runDirectory}/fake-review.md`;
      writeFileSync(reportPath, "# Fake-agent review\n\nThe deterministic system-test agent published this evidence without starting a model.\n");
      const publication = spawnSync(process.execPath, [
        `${runDirectory}/publish-artifact`, reportPath, "--title", "System-test review", "--description", "Evidence published through the generated assignment helper.", "--category", "approval", "--featured",
      ], { encoding: "utf8", env: process.env });
      if (publication.status !== 0) {
        console.error(`fake herdr evidence publication failed: ${publication.stderr || publication.stdout}`);
        process.exit(70);
      }
      state.evidence_published = true;
      writeState(state);
    }
    const response = await fetch(configuration.endpoints.complete, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        outcome,
        summary: "Deterministic fake agent completed the system-test assignment.",
        handoff: "Generated by the fake Herdr executable; no model was started.",
      }),
    });
    if (!response.ok) {
      console.error(`fake herdr callback failed with HTTP ${response.status}: ${await response.text()}`);
      process.exit(67);
    }
    state.callback_submitted = true;
    writeState(state);
  }
}

const state = readState();

if (args[0] === "workspace" && args[1] === "create") {
  writeState(state);
  respond({ root_pane: { pane_id: state.pane } });
} else if (args[0] === "agent" && args[1] === "start") {
  state.agent_gets_since_start = 0;
  writeState(state);
  respond({ pane_id: state.pane });
} else if (args[0] === "agent" && args[1] === "get") {
  state.agent_gets_since_start = (state.agent_gets_since_start ?? 0) + 1;
  writeState(state);
  const configuredReadyAfter = Number.parseInt(process.env.FAKE_HERDR_READY_AFTER_GETS ?? "0", 10);
  const readyAfter = Number.isSafeInteger(configuredReadyAfter) && configuredReadyAfter > 0 ? configuredReadyAfter : 0;
  const ready = state.agent_gets_since_start > readyAfter;
  const startupObservationNoise = process.env.FAKE_HERDR_STARTUP_OBSERVATION_NOISE === "true";
  const sessionAvailable = !startupObservationNoise || (state.prompt_attempts ?? 0) > 0;
  respond({
    agent: {
      agent_status: "idle",
      interactive_ready: ready,
      launch_pending: !ready,
      display_agent: "Fake system-test agent",
      cwd: process.env.FAKE_HERDR_CWD ?? process.cwd(),
      foreground_cwd: process.env.FAKE_HERDR_CWD ?? process.cwd(),
      workspace_id: "fake-workspace",
      tab_id: "fake-tab",
      terminal_id: "fake-terminal",
      revision: startupObservationNoise ? state.agent_gets_since_start : 1,
      ...(sessionAvailable ? { agent_session: { value: state.session, source: "system-test", kind: "fake" } } : {}),
      tokens: {},
    },
  });
} else if (args[0] === "agent" && args[1] === "read") {
  process.stdout.write(state.pending_prompt && process.env.FAKE_HERDR_COLLAPSE_STAGED_PROMPT === "true"
    ? "Claude Code\n[Pasted text #1 +14 lines]" : state.pending_prompt ?? "");
} else if (args[0] === "agent" && args[1] === "prompt") {
  state.prompt_attempts = (state.prompt_attempts ?? 0) + 1;
  const prompt = args[3] ?? "";
  if (process.env.FAKE_HERDR_STAGE_TIMEOUT_PROMPT === "true" && state.prompt_attempts === 1) {
    state.pending_prompt = prompt;
    writeState(state);
    console.error(JSON.stringify({ error: { code: "timeout", message: "Fake prompt remained staged until the wait expired" } }));
    process.exit(1);
  }
  if (process.env.FAKE_HERDR_STAGE_STALLED_PROMPT === "true" && state.prompt_attempts === 1) {
    state.pending_prompt = prompt;
    writeState(state);
    console.error(JSON.stringify({ error: { code: "agent_prompt_stalled", message: "Fake prompt is staged in the composer" } }));
    process.exit(1);
  }
  writeState(state);
  const configuredStalls = Number.parseInt(process.env.FAKE_HERDR_PROMPT_STALLS ?? "0", 10);
  const promptStalls = Number.isSafeInteger(configuredStalls) && configuredStalls > 0 ? configuredStalls : 0;
  if (state.prompt_attempts <= promptStalls) {
    console.error(JSON.stringify({ error: { code: "agent_prompt_stalled", message: "Fake prompt was not delivered" } }));
    process.exit(1);
  }
  await completePrompt(prompt, state);
  respond({ accepted: true });
} else if (args[0] === "agent" && args[1] === "send-keys") {
  if (args.includes("enter") && state.pending_prompt) {
    const prompt = state.pending_prompt;
    delete state.pending_prompt;
    writeState(state);
    await completePrompt(prompt, state);
  }
  if (args.includes("ctrl+c") && state.pending_prompt) {
    delete state.pending_prompt;
    writeState(state);
  }
  respond({ accepted: true });
} else if (args[0] === "agent" && args[1] === "wait") {
  respond({ accepted: true });
} else {
  console.error(`unsupported fake herdr command: ${JSON.stringify(args)}`);
  process.exit(68);
}
