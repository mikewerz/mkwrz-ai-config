TRACKER_URL=http://127.0.0.1:4310
# Set this only when agents need a different reachable callback origin.
# CALLBACK_BASE_URL=http://127.0.0.1:4310
SUPERVISOR_ID=coordinator-vm
# Host identity for repository locking: identical for processes on one VM, unique across VMs.
# SUPERVISOR_HOST=coordinator-vm
# SUPERVISOR_IPS=192.0.2.10
PROJECT_ROOT=/absolute/path/to/agent/projects
# Durable assignment bundles default beneath PROJECT_ROOT. Set an absolute
# supervisor-local path when they should live on a separate volume.
# ASSIGNMENT_ROOT=/srv/agentic-assignments
HERDR_SESSION=agentic-projects
# The workflow installer sets this to its verified per-user Herdr binary.
# HERDR_EXECUTABLE=/absolute/path/to/herdr
PROVIDERS=claude,codex
HEARTBEAT_INTERVAL_MS=30000
IDLE_POLL_MS=5000
# Bounds every Herdr CLI subprocess, including startup, observation, and prompt delivery.
HERDR_COMMAND_TIMEOUT_MS=45000
AGENT_START_READY_TIMEOUT_MS=30000
AGENT_START_READY_SETTLE_MS=10000
# Wait this long after the last observed activity before sending one callback reminder.
CALLBACK_REMINDER_GRACE_MS=60000
ASSIGNMENT_PROMPT_RECOVERY_MS=30000
# Tracker request deadlines. Long-poll claims and artifact transfers have
# separate budgets from ordinary control-plane requests.
TRACKER_REQUEST_TIMEOUT_MS=15000
TRACKER_CLAIM_TIMEOUT_MS=45000
TRACKER_ARTIFACT_TIMEOUT_MS=300000
# Structured logs use debug, info, warn, or error. LOG_FILE enables built-in
# size rotation; deploy.sh sets it from DEPLOY_LOG_FILE automatically.
LOG_LEVEL=info
# LOG_FILE=/absolute/path/to/agentic-project-supervisor.log
LOG_MAX_BYTES=10485760
LOG_MAX_FILES=5
# Optional native harness and live-telemetry locations:
# CODEX_HOME=/srv/agent-config/codex
# CLAUDE_CONFIG_DIR=/srv/agent-config/claude
# AGENTIC_TELEMETRY_ROOT=/srv/agentic-project-supervisor/telemetry
# Best-effort tracker-owned governance evidence for Agent runs.
SESSION_EVIDENCE_ENABLED=true
NATIVE_SESSION_EVIDENCE_ENABLED=true
HERDR_TRANSCRIPT_LINES=5000
SESSION_EVIDENCE_MAX_BYTES=67108864
